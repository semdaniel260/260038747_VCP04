<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎮 Interactive 5x5 Bingo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Player Username"
            android:inputType="text"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <!-- Round and Bingo Status Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvRoundNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Current Round: 1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvBingoAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BINGO: 0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#D32F2F" />
        </LinearLayout>

        <!-- Drawn Numbers Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8EAF6"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvLastDrawn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Drawn Number: --"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3F51B5"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDrawnHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="History: None"
                android:textSize="12sp"
                android:textColor="#555555"
                android:gravity="center" />
        </LinearLayout>

        <!-- Mode Toggle Button -->
        <ToggleButton
            android:id="@+id/toggleGameMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textOn="Mode: AUTO (System Ticks)"
            android:textOff="Mode: MANUAL (User Ticks)"
            android:checked="false"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDrawNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎲 Draw Next Number"
            android:backgroundTint="#FF4081"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <!-- B-I-N-G-O Column Headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="B" android:textStyle="bold" android:textSize="16sp" android:gravity="center" android:textColor="#3F51B5"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="I" android:textStyle="bold" android:textSize="16sp" android:gravity="center" android:textColor="#3F51B5"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="N" android:textStyle="bold" android:textSize="16sp" android:gravity="center" android:textColor="#3F51B5"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="G" android:textStyle="bold" android:textSize="16sp" android:gravity="center" android:textColor="#3F51B5"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="O" android:textStyle="bold" android:textSize="16sp" android:gravity="center" android:textColor="#3F51B5"/>
        </LinearLayout>

        <!-- 5x5 Grid Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <!-- Row 0 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                <TextView android:id="@+id/cell_0" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_1" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_2" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_3" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_4" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
            </LinearLayout>

            <!-- Row 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                <TextView android:id="@+id/cell_5" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_6" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_7" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_8" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_9" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                <TextView android:id="@+id/cell_10" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_11" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_12" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_13" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_14" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                <TextView android:id="@+id/cell_15" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_16" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_17" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_18" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_19" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/cell_20" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_21" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_22" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_23" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
                <TextView android:id="@+id/cell_24" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:background="#E0E0E0" android:layout_margin="2dp"/>
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnGenerateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Roll New 5x5 Card"
            android:backgroundTint="#3F51B5"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSaveRound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Round &amp; Roll New Card"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnResetGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Game to Round 1"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View History &amp; Details"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready to play!"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#444444" />

    </LinearLayout>
</ScrollView>